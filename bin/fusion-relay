#!/usr/bin/env bash
# Manage the local fusion-codex relay process.
#   fusion-relay start [PORT]   - start in background (default port 8931)
#   fusion-relay stop           - stop the background relay
#   fusion-relay status         - show pid, health, routing stats
#   fusion-relay fg [PORT]      - run in the foreground
#   fusion-relay stats          - print routing/usage counters
#   fusion-relay reconcile --acknowledge-unknown --evidence-ref <64hex>
#                               - offline accounting reconciliation
#                                 (refuses while a relay owns the store)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"

# echo pid if running, else nothing — the Python manager verifies service
# identity before any control action instead of trusting a pidfile.
exec python3 -m fusion_relay.launcher "$@"
